# ============================================================
# Job Application Tracker - Environment Variables Example
# ============================================================
# Copy this file and rename it to .env:
#   cp .env.example .env   (or copy-paste in file explorer)
# Then fill in your actual values.
# NEVER commit the real .env file to Git!
# ============================================================

# --- Server Configuration ---
# The port your Node.js backend server will listen on
PORT=5000

# --- JWT (JSON Web Token) Secret ---
# Used to sign and verify login tokens.
# Make this a long, random, hard-to-guess string in production.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_in_production_abc123xyz789
JWT_EXPIRES_IN=7d

# --- MySQL Database Configuration ---
# DB_HOST: Hostname or IP address of your MySQL server.
#   - Local server: localhost (or 127.0.0.1)
DB_HOST=localhost

# DB_PORT: MySQL server port (default is 3306)
DB_PORT=3306

# DB_USER: MySQL user (default local superuser is usually 'root')
DB_USER=root

# DB_PASSWORD: Password for your MySQL user (e.g. your MySQL Workbench password)
DB_PASSWORD=your_mysql_password_here

# DB_DATABASE: Name of the database (created via database/schema.sql)
DB_DATABASE=job_tracker

# ============================================================
# SETUP CHECKLIST:
# 1. Start MySQL Server (e.g. MySQL80 service or MySQL Workbench)
# 2. Run database/schema.sql in MySQL Workbench to create the database and tables
# 3. Optional: Run database/seed.sql in MySQL Workbench to populate test data
# 4. Update DB_PASSWORD above with your actual MySQL password
# 5. Run "npm run dev" to start the backend server
# ============================================================
